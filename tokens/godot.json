{
  "$schema": "https://tr.designtokens.org/schema/stable.json",
  "godot-theme": "Source of truth for all design tokens. Values mirror Godot 4.6+ Modern editor theme (godotengine/godot master). CSS/JS outputs are generated by scripts/build-tokens.mjs — do not edit them by hand.",
  "color": {
    "bg": { "$value": "#141414", "$type": "color", "$description": "Godot window_complex — editor About/dialog backdrop (theme_modern.cpp)" },
    "panel": { "$value": "#292929", "$type": "color", "$description": "Godot base_color 0.161 — Modern default preset (editor_theme_manager.cpp)" },
    "panel-dark": { "$value": "#1c1c1c", "$type": "color", "$description": "Inputs / file lists — base darkened (godot-launcher derivation)" },
    "list-bg": { "$value": "#1f1f1f", "$type": "color", "$description": "Project list panel surface (godot-launcher)" },
    "popup": { "$value": "#121212", "$type": "color", "$description": "Menus / tooltips popup surface (godot-launcher)" },
    "btn": { "$value": "#424242", "$type": "color", "$description": "Button normal (Godot Button normal stylebox family)" },
    "btn-hover": { "$value": "#4d4d4d", "$type": "color", "$description": "Button hover" },
    "btn-pressed": { "$value": "#505050", "$type": "color", "$description": "Button pressed" },
    "btn-border": { "$value": "#484848", "$type": "color", "$description": "Button border" },
    "accent": { "$value": "#569eff", "$type": "color", "$description": "Godot accent_color 0.337,0.62,1.0 — Modern default preset (editor_theme_manager.cpp)" },
    "accent-hover": { "$value": "#77b0ff", "$type": "color", "$description": "Accent hover (godot-launcher derivation)" },
    "success": { "$value": "#73f280", "$type": "color", "$description": "StatusSuccess family — ok states (random-exe-lab extension)" },
    "danger": { "$value": "#ff786b", "$type": "color", "$description": "StatusError family — error / destructive (random-exe-lab extension)" },
    "warn": { "$value": "#d4c79e", "$type": "color", "$description": "StatusWarning family — unstable / warning (random-exe-lab extension)" },
    "text": { "$value": "rgba(255,255,255,.75)", "$type": "color", "$description": "Primary font color — Godot control_font_color scale (default_theme.cpp)" },
    "muted": { "$value": "rgba(255,255,255,.55)", "$type": "color", "$description": "Secondary font color (control_font_low scale)" },
    "faint": { "$value": "rgba(255,255,255,.35)", "$type": "color", "$description": "Disabled / placeholder (control_font_disabled scale)" },
    "sep": { "$value": "rgba(0,0,0,.45)", "$type": "color", "$description": "Separators" },
    "sel": { "$value": "#353535", "$type": "color", "$description": "Selected row (Godot selection family)" },
    "sel-hover": { "$value": "#383838", "$type": "color", "$description": "Selected row hover" },
    "row-hover": { "$value": "#2c2c2c", "$type": "color", "$description": "Row hover" },
    "brand-blue": { "$value": "#478cbf", "$type": "color", "$description": "Godot Blue — brand (editor_color_map.cpp)" },
    "brand-gray": { "$value": "#414042", "$type": "color", "$description": "Godot Gray — brand (editor_color_map.cpp)" },
    "scroll-thumb": { "$value": "rgba(255,255,255,.225)", "$type": "color", "$description": "Scrollbar thumb (godot-launcher)" },
    "scroll-thumb-hover": { "$value": "rgba(255,255,255,.5)", "$type": "color", "$description": "Scrollbar thumb hover" },
    "selection": { "$value": "rgba(86,158,255,.4)", "$type": "color", "$description": "Text selection — accent at 40%" }
  },
  "radius": {
    "md": { "$value": "4px", "$type": "dimension", "$description": "Modern default corner_radius (editor_theme_manager.cpp)" }
  },
  "font": {
    "family": { "$value": "\"Inter\",\"Vazirmatn\",\"Segoe UI\",Tahoma,sans-serif", "$type": "fontFamily", "$description": "Inter substitutes nothing — it IS Godot's editor font; Vazirmatn is Godot's Arabic fallback (editor_fonts.cpp)" },
    "mono": { "$value": "\"JetBrains Mono\",Consolas,monospace", "$type": "fontFamily", "$description": "Godot's code font (editor_fonts.cpp, customizable via code_font setting)" },
    "size-base": { "$value": "14px", "$type": "dimension", "$description": "Godot editor base font size (editor_fonts.cpp)" },
    "size-title": { "$value": "15px", "$type": "dimension", "$description": "Row title = base + 1, bold (project_list.cpp)" },
    "size-small": { "$value": "12px", "$type": "dimension", "$description": "Meta / pills / toasts" },
    "size-tiny": { "$value": "11px", "$type": "dimension", "$description": "Side labels / status bar" }
  },
  "spacing": {
    "base": { "$value": "4px", "$type": "dimension", "$description": "Godot Default spacing preset base_spacing (editor_theme_manager.cpp). Compact=2, Spacious=6" },
    "titlebar": { "$value": "44px", "$type": "dimension", "$description": "Title bar min-height (project_manager.cpp layout)" },
    "row-icon": { "$value": "64px", "$type": "dimension", "$description": "Project row icon — ProjectListItemControl 64px (project_list.cpp)" },
    "row-icon-compact": { "$value": "40px", "$type": "dimension", "$description": "Versions/dense row icon (godot-launcher derivation)" },
    "sidebar": { "$value": "160px", "$type": "dimension", "$description": "Sidebar width (project_manager.cpp layout)" }
  }
}
